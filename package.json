{
    "name": "drewclark.io-portfolio",
    "version": "1.0.0",
    "scripts": {
        "dev": "concurrently \"npm run api\" \"npm run frontend\"",
        "api": "node scripts/start-api-server.js",
        "frontend": "cd app && npm run dev",
        "build": "cd app && npm run build",
        "start": "node server.js",
        "setup": "npm install && cd app && npm install",
        "clean": "rimraf node_modules app/node_modules",
        "lint": "eslint . --ext .js,.jsx",
        "lint:fix": "eslint . --ext .js,.jsx --fix",
        "index:repos": "node scripts/index-repos.js",
        "verify": "node scripts/verify-openai.js"
    },
    "dependencies": {
        "dotenv": "^16.4.7",
        "express": "^4.18.2",
        "express-rate-limit": "^8.7.0",
        "helmet": "^7.1.0",
        "mongodb": "^7.6.0",
        "openai": "^4.93.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.27.0",
        "concurrently": "^8.2.2",
        "cross-env": "^7.0.3",
        "eslint": "^9.27.0",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-unused-imports": "^4.1.4",
        "kill-port": "^2.0.1",
        "nodemon": "^3.0.3",
        "rimraf": "^6.1.3"
    },
    "engines": {
        "node": ">=18.0.0"
    }
}
